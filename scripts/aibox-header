#!/usr/bin/env bash
set -euo pipefail
# looks good

AIBOX_PORT="${AIBOX_PORT:-2222}"

center() {
  local line="$1"
  local cols
  cols="$(tput cols 2>/dev/null || echo 80)"
  local len=${#line}
  if [ "$len" -ge "$cols" ]; then
    echo "$line"
    return
  fi
  local pad=$(( (cols - len) / 2 ))
  printf "%*s%s\n" "$pad" "" "$line"
}

logo_lines() {
  while IFS= read -r line; do
    center "$line"
  done << 'EOF'
_____/\\\\\\\\\_____/\\\\\\\\\\\__/\\\\\\\\\\\\\_________/\\\\\_______/\\\_______/\\\_
 ___/\\\\\\\\\\\\\__\/////\\\///__\/\\\/////////\\\_____/\\\///\\\____\///\\\___/\\\/__
  __/\\\/////////\\\_____\/\\\_____\/\\\_______\/\\\___/\\\/__\///\\\____\///\\\\\\/____
   _\/\\\_______\/\\\_____\/\\\_____\/\\\\\\\\\\\\\\___/\\\______\//\\\_____\//\\\\______
    _\/\\\\\\\\\\\\\\\_____\/\\\_____\/\\\/////////\\\_\/\\\_______\/\\\______\/\\\\______
     _\/\\\/////////\\\_____\/\\\_____\/\\\_______\/\\\_\//\\\______/\\\_______/\\\\\\_____
      _\/\\\_______\/\\\_____\/\\\_____\/\\\_______\/\\\__\///\\\__/\\\_______/\\\////\\\___
       _\/\\\_______\/\\\__/\\\\\\\\\\\_\/\\\\\\\\\\\\\/_____\///\\\\\/______/\\\/___\///\\\_
        _\///________\///__\///////////__\/////////////_________\/////_______\///_______\///__
EOF
}



while true; do
  clear
  logo_lines
  echo
  if nc -z -w 1 localhost "$AIBOX_PORT" >/dev/null 2>&1; then
    status="running..."
    color="$(tput setaf 2)"
  else
    status="stopped"
    color="$(tput setaf 1)"
  fi
  reset="$(tput sgr0)"
  center "${color}${status}${reset}"
  sleep 1
done
